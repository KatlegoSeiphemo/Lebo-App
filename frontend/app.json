{
  "expo": {
    "name": "Lebo",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.safetyalert.kan454",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Share your location during emergencies and Safe Journey",
        "NSFaceIDUsageDescription": "Unlock Lebo and protect your private safety data"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6A8576"
      },
      "package": "com.emergent.safetyalert.kan454",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6A8576"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share your location during emergencies and Safe Journey"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Lebo and protect your private safety data"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
